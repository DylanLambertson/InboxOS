{
  "name": "inboxos",
  "private": true,
  "version": "1.0.0",
  "description": "InboxOS: a self-hosted team email client on Cloudflare Workers, D1 and R2, with shared inboxes, a setup wizard, theming and a full admin console.",
  "keywords": [
    "email",
    "inbox",
    "shared-inbox",
    "cloudflare-workers",
    "d1",
    "r2",
    "resend",
    "self-hosted",
    "react",
    "hono"
  ],
  "homepage": "https://github.com/DylanLambertson/InboxOS#readme",
  "bugs": {
    "url": "https://github.com/DylanLambertson/InboxOS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DylanLambertson/InboxOS.git"
  },
  "license": "AGPL-3.0-only",
  "author": "Dylan Lambertson <me@dylanlambertson.dev> (https://github.com/DylanLambertson)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "bootstrap:local": "node scripts/bootstrap.mjs --local",
    "bootstrap:remote": "node scripts/bootstrap.mjs --remote",
    "deploy": "npm run build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.3",
    "@tanstack/react-query": "^5.103.1",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "dompurify": "^3.4.15",
    "hono": "^4.13.8",
    "lucide-react": "^1.47.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@cloudflare/workers-types": "^5.20260918.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dompurify": "^3.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  }
}
