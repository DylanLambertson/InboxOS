# SETUP_TOKEN=
# Optional: the setup wizard can store these in the app instead.
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxx
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
