{
	// Cloudflare Worker config. See "Deploy" in README.md.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "inboxos",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/webhooks/*",
			"/mcp",
			"/mcp/*",
			"/scim/*",
			"/unsubscribe",
			"/manifest.webmanifest"
		]
	},
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true
		}
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "inboxos",
			// Paste the id printed by `npx wrangler d1 create inboxos`.
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "inboxos-files"
		}
	],
	// Serve the app on your own hostname. Uncomment and set it to the address you'll use.
	// Add one entry per hostname (e.g. mail.example.com and mail.example.org).
	// "routes": [
	// 	{ "pattern": "mail.example.com", "custom_domain": true }
	// ],
	// Every minute: dispatch scheduled sends, deliver webhooks. Daily cleanup runs inside the same handler.
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"vars": {
		// Public URL of the app (used for OAuth redirects, invite links and webhooks).
		"APP_URL": "http://localhost:5173"
	}
	// Secrets (set with `npx wrangler secret put <NAME>`):
	//   SESSION_SECRET            required: any long random string (signs links, encrypts stored keys).
	//                             The setup wizard asks for it to create the first owner, unless SETUP_TOKEN is set.
	//   SETUP_TOKEN               optional: a separate key for creating the first owner in the setup wizard
	//   RESEND_API_KEY            optional: can be entered in the setup wizard instead
	//   RESEND_WEBHOOK_SECRET     optional: captured automatically by the setup wizard
	//   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET   optional: enables Google sign-in
	//   VAPID_PRIVATE_JWK         optional: enables push notifications
}
